{
  "name": "fito",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync": "npx cap sync android",
    "android": "npm run build && npm run sync && npx cap open android",
    "test:engine": "tsx scripts/test-substitution.ts",
    "build:myket": "cross-env VITE_APP_FLAVOR=myket vite build",
    "build:bazaar": "cross-env VITE_APP_FLAVOR=bazaar vite build",
    "build:personal": "cross-env VITE_APP_FLAVOR=personal vite build",
    "android:myket": "npm run build:myket && npx cap sync android",
    "android:bazaar": "npm run build:bazaar && npx cap sync android",
    "android:personal": "npm run build:personal && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@salarizadi/capacitor-cafebazaar-poolakey": "^1.1.0",
    "@salarizadi/capacitor-myket": "^1.0.0",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "version": "1.0.0"
}
